{
  "name": "solosync",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test tests/e2e/smoke.spec.ts --project=chromium",
    "test:e2e:portfolio": "playwright test tests/e2e/accessibility.spec.ts tests/e2e/portfolio-demo.spec.ts --project=chromium",
    "qa:preview": "node scripts/preview-qa-smoke.mjs",
    "security:client-env": "node scripts/security-client-env-guard.mjs",
    "security:rls": "node scripts/security-rls-coverage.mjs",
    "security:check": "npm run security:client-env && npm run security:rls && npm audit --omit=dev",
    "check": "npm run lint && npm run typecheck && npm run test",
    "report:micro-missions": "node scripts/micro-mission-return-report.mjs",
    "report:phase-b": "node scripts/phase-b-analytics-report.mjs"
  },
  "dependencies": {
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@sentry/nextjs": "^10.46.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.48.1",
    "@vercel/analytics": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "next": "^15.1.8",
    "next-intl": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.5.5",
    "web-push": "^3.6.7",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.8",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.12",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^4.1.2"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
